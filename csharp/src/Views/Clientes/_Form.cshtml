@model Facturas.Models.ClienteSemana3
@{
    string action = ViewContext.RouteData.Values["action"]?.ToString() ?? "Create";
}
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<fieldset class="form-group">
    <legend>Identificación</legend>
    <div class="field"><label asp-for="Cedula">Cédula</label><input asp-for="Cedula" maxlength="10" /><span asp-validation-for="Cedula" class="text-danger"></span></div>
    <div class="field"><label asp-for="Nombres"></label><input asp-for="Nombres" maxlength="80" /><span asp-validation-for="Nombres" class="text-danger"></span></div>
    <div class="field"><label asp-for="Apellidos"></label><input asp-for="Apellidos" maxlength="80" /><span asp-validation-for="Apellidos" class="text-danger"></span></div>
    <div class="field"><label asp-for="FechaNacimiento">Fecha de nacimiento</label><input asp-for="FechaNacimiento" type="date" /><span asp-validation-for="FechaNacimiento" class="text-danger"></span></div>
</fieldset>
<fieldset class="form-group">
    <legend>Contacto</legend>
    <div class="field"><label asp-for="Correo"></label><input asp-for="Correo" type="email" maxlength="120" /><span asp-validation-for="Correo" class="text-danger"></span></div>
    <div class="field"><label asp-for="Telefono">Teléfono</label><input asp-for="Telefono" maxlength="20" /><span asp-validation-for="Telefono" class="text-danger"></span></div>
</fieldset>
<fieldset class="form-group">
    <legend>Ubicación</legend>
    <div class="field wide"><label asp-for="Direccion">Dirección</label><input asp-for="Direccion" maxlength="160" /><span asp-validation-for="Direccion" class="text-danger"></span></div>
    <div class="field"><label asp-for="Ciudad"></label><input asp-for="Ciudad" maxlength="80" /><span asp-validation-for="Ciudad" class="text-danger"></span></div>
    <div class="field"><label asp-for="Provincia"></label><input asp-for="Provincia" maxlength="80" /><span asp-validation-for="Provincia" class="text-danger"></span></div>
    <div class="field checkbox-field"><label><input asp-for="Activo" /> Activo</label></div>
</fieldset>
<div class="form-actions">
    <button type="submit">@(action == "Create" ? "Crear cliente" : "Guardar cambios")</button>
    <a class="button secondary" asp-action="Index">Cancelar</a>
</div>
