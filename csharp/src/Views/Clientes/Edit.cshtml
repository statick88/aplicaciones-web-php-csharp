@model Facturas.Models.ClienteSemana3
@{ ViewData["Title"] = "Editar cliente"; }
<!DOCTYPE html>
<html lang="es"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Editar cliente</title><partial name="_ShellHead" /></head><body>
<partial name="_ShellHeader" />
<section aria-labelledby="titulo-editar">
    <div class="page-heading"><div><p class="eyebrow">Cliente #@Model.Id</p><h1 id="titulo-editar">Editar cliente</h1><p>Actualiza los datos necesarios y guarda los cambios.</p></div></div>
