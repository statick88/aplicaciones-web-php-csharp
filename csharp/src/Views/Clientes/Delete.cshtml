@model Facturas.Models.ClienteSemana3
<!DOCTYPE html>
<html lang="es"><head><meta charset="utf-8" /><title>Eliminar cliente</title></head>
<body>
    <h1>Eliminar cliente</h1>
    <p>¿Confirma que desea eliminar este cliente?</p>
    <partial name="_ClienteDatos" model="Model" />
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
        <button type="submit">Eliminar</button>
        <a asp-action="Details" asp-route-id="@Model.Id">Cancelar</a>
    </form>
</body></html>
