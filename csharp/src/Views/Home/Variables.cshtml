@model List<Facturas.Models.VariableDemo>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Variables en C#</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>
<body class="bg-light">
    <div class="container mt-5">
        <div class="card shadow">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h2 class="mb-0">Variables en C# (.NET) — S1C2</h2>
                <a asp-action="Index" class="btn btn-sm btn-outline-light">Ejercicio facturas</a>
            </div>
            <div class="card-body">
                <p class="text-muted mb-4">
                    Declaración, tipado y ámbito en C#, en contraste con
                    <code>src/variables.php</code> del stack PHP (mismo ejercicio en ambos lenguajes).
                </p>
                <table class="table table-striped mb-0">
                    <thead>
                        <tr><th>Concepto</th><th>Código</th><th>Resultado</th><th>Tipo</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var fila in Model)
                        {
                            <tr>
                                <td>@fila.Concepto</td>
                                <td><code>@fila.Codigo</code></td>
                                <td>@fila.Resultado</td>
                                <td><code>@fila.Tipo</code></td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="alert alert-info mt-4 mb-0">
                    <strong>Contraste clave:</strong> en C# las variables de un <code>if</code>/<code>foreach</code>
                    tienen ámbito de bloque (el compilador lo exige); en PHP esa misma variable sigue
                    después del bloque. Ver <code>variables.php</code> en el otro stack.
                </div>
            </div>
        </div>
        <p class="text-center mt-3"><a asp-action="Index">Volver al inicio</a></p>
    </div>
</body>
</html>
